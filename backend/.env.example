# Local dev: point this at the same Render Postgres instance the blueprint
# creates ("External Database URL" in the Render dashboard), or any other
# reachable Postgres. Prisma needs a real "postgresql://" URL even locally.
DATABASE_URL="postgresql://user:password@host:5432/kalorien_tracker?schema=public"
PORT=3001

# Open Food Facts needs no API key.

# Optional fallback sources (leave empty to disable):
USDA_FDC_API_KEY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Comma-separated list of allowed frontend origins in production
# (e.g. https://fynn1506.github.io). Leave empty to allow all (fine for local dev).
CORS_ORIGIN=
